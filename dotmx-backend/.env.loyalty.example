# User Service & Loyalty Program Environment Variables

# User Service Database (Separate from Exchange)
USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_NAME=dotmx_users
USER_DB_USER=postgres
USER_DB_PASSWORD=your_secure_password
USER_DB_POOL_SIZE=20

# Exchange Database (Existing)
EXCHANGE_DB_HOST=localhost
EXCHANGE_DB_PORT=5432
EXCHANGE_DB_NAME=dotmx_exchange
EXCHANGE_DB_USER=postgres
EXCHANGE_DB_PASSWORD=your_secure_password
EXCHANGE_DB_POOL_SIZE=50

# Loyalty Points Configuration
POINTS_PER_USD_VOLUME=0.01         # 1 point per $100 volume
MIN_VOLUME_FOR_POINTS=10           # Minimum $10 volume to earn points
MAX_DAILY_POINTS=100000            # Maximum 100k points per day

# Loyalty Tier Thresholds (lifetime earned points)
TIER_BRONZE=0
TIER_SILVER=10000
TIER_GOLD=50000
TIER_PLATINUM=200000
TIER_DIAMOND=1000000

# Referral System Configuration
REFERRAL_CODE_PREFIX=DOTMX
REFERRAL_CODE_LENGTH=8
REFERRAL_SIGNUP_REWARD=100         # Points for both referrer and referee
REFERRAL_FIRST_TRADE_REWARD=500    # Points for first trade completion
REFERRAL_COMMISSION_PCT=10         # 10% commission on referee volume
MAX_ACTIVE_CODES_PER_USER=5        # Maximum active referral codes per user

# Referral Volume Milestones (volume in USD: reward in points)
REFERRAL_MILESTONE_1=1000:100      # $1k volume = 100 points
REFERRAL_MILESTONE_2=10000:500     # $10k volume = 500 points
REFERRAL_MILESTONE_3=50000:2000    # $50k volume = 2000 points
REFERRAL_MILESTONE_4=100000:5000   # $100k volume = 5000 points
REFERRAL_MILESTONE_5=500000:20000  # $500k volume = 20000 points

# Volume Sync Service
VOLUME_SYNC_INTERVAL_MINUTES=5     # Sync every 5 minutes
VOLUME_SYNC_ENABLED=true           # Enable automatic syncing

# Profit Multiplier Configuration
# These are defined in the database schema (profit_multiplier_tiers table)
# but can be overridden via admin API if needed

# Monthly Commission Distribution
# Typically run via cron job on the 1st of each month
MONTHLY_COMMISSION_DAY=1           # Day of month to distribute commissions
MONTHLY_COMMISSION_HOUR=0          # Hour (UTC) to run commission distribution
