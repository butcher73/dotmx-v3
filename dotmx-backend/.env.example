# Server Ports
# 3001 = Engine Server (order matching)
# 3002 = MarketData Server (price feeds, orderbook)
# 3003 = API Server (user-facing REST API)
# 3004 = Management Server (admin panel API - Alfred)
PORT=3003
MANAGEMENT_API_PORT=3004
NODE_ENV=development

# Kong API Gateway
KONG_PROXY_URL=http://localhost:8000
KONG_ADMIN_URL=http://localhost:8001
TRUST_PROXY=true

# Message Bus
NATS_URL=nats://localhost:4222

# Cache
REDIS_URL=redis://localhost:6379

# Database
DATABASE_URL=postgresql://dotmx:dotmx_dev@localhost:5432/dotmx

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRY=900 # 15 minutes in seconds
JWT_REFRESH_EXPIRY=604800 # 7 days in seconds
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=1800 # 30 minutes in seconds

# GCP KMS Configuration (Required for Custodial Wallet)
GCP_PROJECT_ID=your-gcp-project-id
GCP_KMS_LOCATION=us-central1
GCP_KMS_KEY_RING=dotmx-wallet-keys
GCP_KMS_KEY_NAME=master-seed-kek
# Note: Set GOOGLE_APPLICATION_CREDENTIALS env var for service account
# Note: Run 'bun wallet:init' to initialize (generate new seed)
# Note: Run 'bun wallet:import' to initialize (import existing seed)

# Blockchain RPC URLs
ETH_RPC_URL=https://eth.llamarpc.com
MATIC_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
OP_RPC_URL=https://mainnet.optimism.io

# Sweeper Configuration
SWEEPER_INTERVAL_MS=30000
SWEEPER_MAX_GAS_GWEI=100
SWEEPER_MIN_VALUE_USD=10
SWEEPER_BATCH_SIZE=50

# Withdrawal Configuration
WITHDRAWAL_MIN_DELAY_SECONDS=0
WITHDRAWAL_LARGE_THRESHOLD_USD=10000
WITHDRAWAL_LARGE_DELAY_HOURS=24
WITHDRAWAL_DAILY_LIMIT_USD=100000
WITHDRAWAL_MAX_PENDING=10

# Email Service (for verification and password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@dotmx.xyz

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_MAX=100 # requests per window
RATE_LIMIT_WINDOW=60 # seconds

# Persistence
JOURNAL_PATH=./data/journal
SNAPSHOT_PATH=./data/snapshots
SNAPSHOT_INTERVAL_MS=5000

# Alchemy Webhook (for deposit detection)
# Get API key from: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your-alchemy-api-key
ALCHEMY_WEBHOOK_SIGNING_KEY=your-webhook-signing-key
ALCHEMY_WEBHOOK_URL=https://your-domain.com/webhooks/alchemy/deposits
# Note: Set up Address Activity webhooks in Alchemy dashboard

# Deposit Confirmation Checker
CONFIRMATION_POLL_MS=30000
CONFIRMATION_BATCH_SIZE=100
CONFIRMATION_MAX_AGE_HOURS=48

# Market Data
THROTTLE_MS=100

# Risk
MAX_ORDER_SIZE=1000000
MAX_NOTIONAL=50000000
PRICE_DEVIATION_THRESHOLD=0.05

# Logging
LOG_LEVEL=debug
