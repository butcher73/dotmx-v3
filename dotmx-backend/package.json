{
  "name": "dotmx-backend",
  "version": "3.0.0",
  "private": true,
  "description": "DotMX Matching Engine - Monorepo",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev/start-services.sh",
    "dev:all": "bash scripts/dev/start-services.sh",
    "dev:api": "PORT=3003 bun run apps/api-server-with-auth.ts",
    "dev:management": "MANAGEMENT_API_PORT=3004 bun run apps/management-server.ts",
    "dev:engine": "PORT=3001 bun run apps/engine-server.ts",
    "dev:marketdata": "PORT=3002 bun run apps/marketdata-server.ts",
    "start:api": "bun run apps/api-server-with-auth.ts",
    "start:management": "bun run apps/management-server.ts",
    "admin:password": "bun run scripts/update-admin-password.ts",
    "wallet:init": "bun run scripts/init-hd-wallet.ts",
    "wallet:import": "bun run scripts/init-hd-wallet.ts --import",
    "build": "bun run --filter '*' build",
    "start-dev": "bun run apps/api-server.ts",
    "test": "bun test packages/",
    "test:unit": "bun test packages/ --exclude '**/tests/integration/**'",
    "test:unit:shared": "bun test packages/shared/tests --exclude '**integration**'",
    "test:unit:api": "bun test packages/api/tests/",
    "test:unit:engine": "bun test packages/engine/tests/",
    "test:unit:ledger": "bun test packages/ledger/tests/",
    "test:unit:concurrency": "bun test packages/ --concurrency 1 --exclude '**/tests/integration/**'",
    "test:integration": "bun test packages/*/tests/integration/ tests/integration/",
    "test:integration:shared": "bun test packages/shared/tests/integration/",
    "test:performance": "bun test tests/performance/load.test.ts",
    "test:e2e": "bun test tests/e2e/",
    "test:all": "bun test packages/ tests/",
    "test:db": "bash scripts/test-db-setup.sh",
    "test:db:setup": "bash scripts/test-db-setup.sh",
    "bench": "bun run apps/cli.ts bench",
    "throughput": "bun run apps/cli.ts throughput",
    "cli": "bun run apps/cli.ts",
    "deploy:db": "bash scripts/deploy-db.sh production",
    "deploy:db:staging": "bash scripts/deploy-db.sh staging",
    "deploy:db:dev": "bash scripts/deploy-db.sh development",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "clean": "rm -rf packages/*/dist apps/*.js",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d"
  },
  "dependencies": {
    "@dotmx/api": "workspace:*",
    "@dotmx/engine": "workspace:*",
    "@dotmx/gateway": "workspace:*",
    "@dotmx/ledger": "workspace:*",
    "@dotmx/management": "workspace:*",
    "@dotmx/marketdata": "workspace:*",
    "@dotmx/persistence": "workspace:*",
    "@dotmx/shared": "workspace:*",
    "@dotmx/tools": "workspace:*",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "latest",
    "ethers": "^6.13.0",
    "otpauth": "^9.4.1",
    "pg": "^8.11.3",
    "viem": "^2.21.50",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "typescript": "^5.3.3"
  }
}
