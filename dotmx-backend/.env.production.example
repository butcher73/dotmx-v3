# Example environment file for production deployment
# Copy this to .env.production and configure for your environment

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database Host
DB_HOST=localhost
DB_PORT=5432

# Database User (should have CREATE DATABASE permissions)
DB_USER=kowito
DB_PASSWORD=

# Database Names
USER_DB_NAME=dotmx_users
EXCHANGE_DB_NAME=dotmx

# Test Databases (optional)
TEST_USER_DB_NAME=dotmx_users_test
TEST_EXCHANGE_DB_NAME=dotmx_test

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# API Configuration
API_PORT=3000
ENGINE_PORT=3001
MARKETDATA_PORT=3002

# CORS Configuration
CORS_ORIGIN=*

# ============================================================================
# REDIS CONFIGURATION (Optional)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# NATS CONFIGURATION (Optional)
# ============================================================================
NATS_URL=nats://localhost:4222

# ============================================================================
# MONITORING & LOGGING (Optional)
# ============================================================================
LOG_LEVEL=info
ENABLE_METRICS=true

# ============================================================================
# ALCHEMY WEBHOOK CONFIGURATION
# ============================================================================
# Get API key from: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your-alchemy-api-key
ALCHEMY_WEBHOOK_SIGNING_KEY=your-webhook-signing-key
ALCHEMY_WEBHOOK_URL=https://api.dotmx.xyz/webhooks/alchemy/deposits

# Deposit Confirmation Checker
CONFIRMATION_POLL_MS=30000
CONFIRMATION_BATCH_SIZE=100
CONFIRMATION_MAX_AGE_HOURS=48

# Blockchain RPC URLs (use Alchemy or Infura for production)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
MATIC_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BSC_RPC_URL=https://bsc-dataseed1.binance.org
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
OP_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Sweeper Configuration
SWEEPER_INTERVAL_MS=60000
SWEEPER_MAX_GAS_GWEI=150
SWEEPER_MIN_VALUE_USD=50
SWEEPER_BATCH_SIZE=50

# Withdrawal Configuration
WITHDRAWAL_MIN_DELAY_SECONDS=300
WITHDRAWAL_LARGE_THRESHOLD_USD=10000
WITHDRAWAL_LARGE_DELAY_HOURS=24
WITHDRAWAL_DAILY_LIMIT_USD=100000
WITHDRAWAL_MAX_PENDING=10

# GCP KMS Configuration (Required for Custodial Wallet)
GCP_PROJECT_ID=your-gcp-project-id
GCP_KMS_LOCATION=us-central1
GCP_KMS_KEY_RING=dotmx-wallet-keys
GCP_KMS_KEY_NAME=master-seed-kek
