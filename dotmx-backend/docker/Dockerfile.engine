# Engine service
FROM oven/bun:1.1-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json bun.lock ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/engine/package.json ./packages/engine/
COPY packages/api/package.json ./packages/api/
COPY packages/gateway/package.json ./packages/gateway/
COPY packages/persistence/package.json ./packages/persistence/
COPY packages/marketdata/package.json ./packages/marketdata/
COPY packages/ledger/package.json ./packages/ledger/
COPY packages/zk/package.json ./packages/zk/
COPY packages/tools/package.json ./packages/tools/
COPY packages/management/package.json ./packages/management/
RUN bun install

FROM deps AS builder
COPY . .
RUN bun run build

FROM base AS runner
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/engine/dist ./packages/engine/dist
COPY --from=builder /app/packages/engine/package.json ./packages/engine/
COPY --from=builder /app/packages/gateway/dist ./packages/gateway/dist
COPY --from=builder /app/packages/gateway/package.json ./packages/gateway/
COPY --from=builder /app/packages/persistence/dist ./packages/persistence/dist
COPY --from=builder /app/packages/persistence/package.json ./packages/persistence/
COPY --from=builder /app/package.json ./

# Create data directories
RUN mkdir -p /data/journal /data/snapshots

CMD ["bun", "run", "packages/engine/dist/index.js"]
