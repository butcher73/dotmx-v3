# ─── Database (direct DB access for seeding) ───
DATABASE_URL=postgresql://dotmx:dotmx_dev@localhost:5432/dotmx

# ─── Exchange API ───
API_BASE_URL=http://localhost:8080/api
WS_MARKET_URL=ws://localhost:8080/api/ws/market

# ─── Market Making ───
# Spread in basis points (100 = 1%)
DEFAULT_SPREAD_BPS=50
# Number of levels on each side of the book
ORDER_LEVELS=5
# Order size per level in USD
ORDER_SIZE_USD=1000
# How often to refresh quotes (ms)
REFRESH_INTERVAL_MS=5000
# Max position size per market (USD)
MAX_POSITION_USD=50000

# ─── Risk ───
# Maximum loss before halting (USD)
MAX_LOSS_USD=10000
# Inventory skew factor (0 = no skew, 1 = aggressive skew)
INVENTORY_SKEW=0.3

# ─── Reference prices ───
# Use external price feed (binance) or internal orderbook midpoint
PRICE_SOURCE=binance
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
